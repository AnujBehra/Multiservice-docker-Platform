# Copy to .env and adjust values before running `docker compose up --build`

# API runtime/security settings
CORS_ORIGINS=http://localhost:8080
TODO_CACHE_TTL_SECONDS=30
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=300
DEMO_SEED_ENABLED=true

# Grafana alerting email settings (SMTP)
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_SKIP_VERIFY=false
ALERT_EMAIL_FROM=grafana@your-domain.com
ALERT_EMAIL_FROM_NAME=Multi-Service Alerts
ALERT_EMAIL_TO=team-alerts@your-domain.com

# Slack incoming webhook URL for Grafana alert notifications
SLACK_WEBHOOK_URL=https://example.com/replace-with-your-slack-webhook
