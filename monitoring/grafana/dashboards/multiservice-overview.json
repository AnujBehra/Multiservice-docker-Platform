{
  "id": null,
  "uid": "multiservice-overview",
  "title": "Multi-Service Overview",
  "tags": ["docker", "api", "todos"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Request Rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ms_api_http_request_duration_ms_count[1m]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P95 Request Duration (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ms_api_http_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Todos",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "ms_api_todos_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Todos Created / min",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(ms_api_todos_created_total[1m]))",
          "legendFormat": "created",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache Hits vs Misses",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(ms_api_todo_cache_hits_total[1m]))",
          "legendFormat": "hits",
          "refId": "A"
        },
        {
          "expr": "sum(increase(ms_api_todo_cache_misses_total[1m]))",
          "legendFormat": "misses",
          "refId": "B"
        }
      ]
    }
  ]
}
